<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://workflowConfigurationDetailView.title"
      focusComponent="form">
    <data>
        <instance id="workflowConfigurationDc"
                  class="ru.javaboys.vibejson.entity.WorkflowConfiguration">
            <fetchPlan extends="_base"/>
            <loader id="workflowConfigurationDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout classNames="vj-crud-view">
        <h2 id="pageTitle" text="msg://workflowConfigurationDetailView.title" classNames="vj-page-title"/>
        <formLayout id="form" dataContainer="workflowConfigurationDc" classNames="vj-form-card">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="json_pathField" property="jsonPath" colspan="2" placeholder="$.compiled.activities[0]"/>
            <codeEditor id="jsonField" height="24em" property="json" mode="JSON" theme="ONE_DARK" showPrintMargin="false" colspan="2"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction" themeNames="primary"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
