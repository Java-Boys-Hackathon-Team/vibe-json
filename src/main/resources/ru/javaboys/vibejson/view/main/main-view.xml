<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<mainView xmlns="http://jmix.io/schema/flowui/main-view"
          title="msg://MainView.title">
    <actions>
        <action id="logoutAction" type="logout"/>
    </actions>
    <appLayout>
        <!-- Шапка нужна только на узких экранах: там меню выезжает поверх
             содержимого и открывается кнопкой. На широких экранах её скрывает
             тема, а заголовок показывает сам экран. -->
        <navigationBar>
            <header id="header" classNames="jmix-main-view-header">
                <drawerToggle id="drawerToggle"
                              classNames="jmix-main-view-drawer-toggle"
                              themeNames="contrast"
                              ariaLabel="msg://drawerToggle.ariaLabel"/>
                <h1 id="viewTitle" classNames="jmix-main-view-title"/>
            </header>
        </navigationBar>
        <drawerLayout>
            <section id="section" classNames="jmix-main-view-section">
                <h2 id="applicationTitle"
                    classNames="jmix-main-view-application-title">
                    <anchor id="baseLink"
                            href="."
                            title="msg://applicationTitle.text"
                            classNames="jmix-main-view-application-title-base-link vj-brand">
                        <image id="brandLogo" resource="icons/logo.svg" classNames="vj-brand-logo"/>
                    </anchor>
                </h2>
                <nav id="navigation"
                     classNames="jmix-main-view-navigation"
                     ariaLabel="msg://navigation.ariaLabel">
                    <listMenu id="menu"/>
                </nav>
                <footer id="footer" classNames="jmix-main-view-footer">
                    <button id="themeToggle"
                            icon="ADJUST"
                            title="msg://themeToggle.title"
                            themeNames="tertiary icon"
                            classNames="vj-rail-button"/>
                    <div id="userBox" classNames="vj-rail-user"/>
                    <button id="logoutButton"
                            action="logoutAction"
                            title="msg://logout.title"
                            themeNames="tertiary icon"
                            classNames="jmix-logout-button vj-rail-button"/>
                </footer>
            </section>
        </drawerLayout>
        <initialLayout>
        </initialLayout>
    </appLayout>
</mainView>
