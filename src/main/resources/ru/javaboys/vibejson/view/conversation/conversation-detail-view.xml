<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://conversationDetailView.title"
      focusComponent="form">
    <data>
        <instance id="conversationDc"
                  class="ru.javaboys.vibejson.entity.Conversation">
            <fetchPlan extends="_base"/>
            <loader id="conversationDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout classNames="vj-crud-view">
        <h2 id="pageTitle" text="msg://conversationDetailView.title" classNames="vj-page-title"/>
        <formLayout id="form" dataContainer="conversationDc" classNames="vj-form-card">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="titleField" property="title"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction" themeNames="primary"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
